class Point2D:
    """Класс для представления точки в 2D пространстве."""

    def __init__(self, x, y):
        """Конструктор класса Point2D.

        Args:
            x: Координата x.
            y: Координата y.
        """
        self.x = x
        self.y = y


class Point3D(Point2D):
    """Класс для представления точки в 3D пространстве, использующий slots."""

    __slots__ = ('x', 'y', '_z')  # Определяем атрибуты, которые можно хранить

    def __init__(self, x, y, z):
        """Конструктор класса Point3D.

        Args:
            x: Координата x.
            y: Координата y.
            z: Координата z.
        """
        super().__init__(x, y)  # Вызываем конструктор родительского класса
        self._z = z

    @property
    def z(self):
        """Свойство для доступа к координате z (только для чтения)."""
        return self._z

    @z.setter
    def z(self, value):
        """Сеттер для координаты z, который выбрасывает исключение.

        Args:
            value: Новое значение координаты z (не используется).

        Raises:
            AttributeError: Всегда выбрасывается при попытке изменить z.
        """
        raise AttributeError("Нельзя изменить координату z напрямую.")


# Тестовый сценарий:
if __name__ == '__main__':
    # 1. Создание экземпляра Point3D
    pt3 = Point3D(10, 20, 30)

    # 2. Вывод значений x, y и z
    print(f"x: {pt3.x}, y: {pt3.y}, z: {pt3.z}")  # Ожидаемый вывод: x: 10, y: 20, z: 30

    # 3. Попытка изменить z и обработка исключения
    try:
        pt3.z = 40
    except AttributeError as e:
        print(f"Поймано исключение: {e}")  # Ожидаемый вывод: Поймано исключение: Нельзя изменить координату z напрямую.

    # 4. Попытка добавить новый атрибут и обработка исключения
    try:
        pt3.extra = 100
    except AttributeError as e:
        print(f"Поймано исключение: {e}")  # Ожидаемый вывод: Поймано исключение: 'Point3D' object has no attribute 'extra'

    # 5. Проверка отсутствия словаря __dict__
    try:
        print(pt3.__dict__)
    except AttributeError as e:
        print(f"Поймано исключение: {e}")  # Ожидаемый вывод: Поймано исключение: 'Point3D' object has no attribute '__dict__'

    # Проверка работы Point2D
    pt2 = Point2D(5, 7)
    print(f"Point2D - x: {pt2.x}, y: {pt2.y}") # Ожидаемый вывод: Point2D - x: 5, y: 7
    pt2.extra = 10 # Добавление атрибута работает
    print(f"Point2D - extra: {pt2.extra}") # Ожидаемый вывод: Point2D - extra: 10
    print(pt2.__dict__) # Вывод словаря атрибутов Point2D
