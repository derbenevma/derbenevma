class Animal:
    def speak(self):
        return "Издает звук"

class MixinSwim:
    def swim(self):
        return "Плаваeт"

class MixinFly:
    def fly(self):
        return "Летает"

class Duck(Animal, MixinSwim, MixinFly):
    def speak(self):
        return "Кря-кря"

class Penguin(Animal, MixinSwim):
    def speak(self):
        return "Буль-буль"

animals = [Duck(), Penguin()]

for animal in animals:
    print(f"{animal.__class__.__name__}:")
    print(f"  {animal.speak()}")
    print(f"  {animal.swim()}")
    if isinstance(animal, MixinFly):
        print(f"  {animal.fly()}")